MODEL_ID=Qwen/Qwen2.5-VL-3B-Instruct
OVERRIDE_MODEL_ID=Qwen/Qwen2.5-VL-3B-Instruct
MODEL_DTYPE=bfloat16
# xai_toolkit coders from ilsp/vlm-transcoders (qwen2.5-vl-3b-instruct), converted with utils/neuronpedia-utils/neuronpedia_utils/xai_toolkit
# (`make xai-import`). float32 keeps them faithful to xai_toolkit's forward; all 36 layers stay in host
# RAM and SAE paging keeps SAE_GPU_BUDGET_GIB of them on the GPU, reserved per request.
SAE_DTYPE=float32
MAX_LOADED_SAES=36
SAE_GPU_BUDGET_GIB=4
SAE_SETS='["xai-tc-topk128-16x"]'
# Image input enters through the HF forward's keyword inputs, which only the eager backend passes.
FORCE_BACKEND=eager
# An image expands into hundreds of placeholder tokens, which the default 200 cannot fit.
TOKEN_LIMIT=1024
