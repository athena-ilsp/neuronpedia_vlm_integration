MODEL_ID=google/gemma-3-4b-it
OVERRIDE_MODEL_ID=google/gemma-3-4b-it
MODEL_DTYPE=bfloat16
# float32 keeps the converted transcoders bit-faithful to xai_toolkit's own forward; at 0.84 GiB a
# layer, MAX_LOADED_SAES bounds how many stay on the GPU next to the model (the rest page in).
SAE_DTYPE=float32
MAX_LOADED_SAES=8
# xai_toolkit top-k transcoders (k=64, 16x) on Gemma 3 4B IT, from ilsp/vlm-transcoders, converted with
# utils/neuronpedia-utils/neuronpedia_utils/xai_toolkit. The set resolves through extra_saes.yaml or,
# for a local export, the gitignored apps/inference/neuronpedia_inference/extra_saes.local.yaml.
SAE_SETS='["xai-tc-topk64-16x"]'
# Image input enters through the HF forward's keyword inputs, which only the eager backend passes.
FORCE_BACKEND=eager
# One image expands into 256 placeholder tokens on Gemma 3, so the default 200 cannot fit one.
TOKEN_LIMIT=1024
